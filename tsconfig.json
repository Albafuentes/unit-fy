{
    "compilerOptions": {
      "target": "ES6",
      "module": "ESNext",
      "lib": ["DOM", "ESNext"],
      "declaration": true,
      "outDir": "dist",
      "strict": true,
      "jsx": "react-jsx",
      "moduleResolution": "bundler",
      "esModuleInterop": true,
      "skipLibCheck": true,

      "paths": {
        "@/*": ["./src/*"]
      }
    },
    "include": ["src", "vitest.setup.ts", "vitest.config.ts"]
  }